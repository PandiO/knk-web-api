        },
        {
          "fieldGuid": "23341ead-101d-5676-bcdc-f19c33a6c609",
          "fieldName": "ShowEnterLeaveMessages",
          "label": "Enter and leave messages",
          "description": "Players see the landmark's name when they cross its border.",
          "fieldType": "Boolean"
        }
      ]
    },
    {
      "sectionGuid": "aed59752-f570-5528-b882-6296584f1093",
      "sectionName": "Warp destination",
      "description": "Whether players can /warp to the landmark's point.",
