{
  "format": "knk-formconfig/1",
  "configurationGuid": "5f9de95e-f287-58dd-8d03-cf2f70ecd51a",
  "entityTypeName": "GateDoor",
  "name": "GateDoor - Default (seed v4)",
  "description": "One door of a gate: type, shape, motion, block scan, health and display. Usually opened from the gate's Gate doors step. Seed v2 (KNG-193): deck length for drawbridges, door materials for region and flood-fill scans. Seed v3 (KNG-268/KNG-270): the open-door anchor may stay empty when the opened door stays inside the door box, and the open-door scan explains when it is needed and how. Seed v4 (PandiO/knk-workspace#167): the pass-through styles the door offers (animated, snap, walk-path, teleport) and its default style.",
  "steps": [
    {
      "stepGuid": "00a19010-ad3f-5c73-9f59-e33c0c159974",
      "stepName": "Door",
      "description": "Which gate the door belongs to and what kind of door it is. Opened from a gate's Gate doors step, the gate is already filled in.",
      "isManyToManyRelationship": false,
      "fields": [
        {
          "fieldGuid": "52972356-dc9e-524e-8f4a-253342f13c12",
          "fieldName": "GateStructureId",
          "label": "Gate",
          "description": "The gate this door belongs to. Its region is used to check the door's points.",
          "fieldType": "Object",
          "objectType": "GateStructure",
          "isRequired": true,
          "isReadOnly": false
        },
        {
          "fieldGuid": "d79f1724-e056-5983-9c5c-76675676b0c0",
          "fieldName": "Name",
          "label": "Name",
          "description": "Unique within the gate; /gatedoor commands use it, e.g. 'Left' or 'Portcullis'.",
          "fieldType": "String",
          "isRequired": true,
          "isReadOnly": false
        },
        {
          "fieldGuid": "83bca48d-58cd-5333-823b-de4a36a1e884",
          "fieldName": "GateType",
          "label": "Door type",
          "description": "Sliding: a portcullis or sliding wall. Trap: a hatch. Drawbridge: swings down on a hinge. Double doors: two wings on hinges.",
          "fieldType": "Enum",
          "defaultValue": "SLIDING",
          "isRequired": true,
          "isReadOnly": false,
          "settingsJson": "{\"enumValues\": [\"SLIDING\", \"TRAP\", \"DRAWBRIDGE\", \"DOUBLE_DOORS\"]}"
        },
        {
          "fieldGuid": "89863b69-e84f-56a9-861b-7885a4673289",
          "fieldName": "GeometryDefinitionMode",
          "label": "Shape from",
          "description": "Plane grid: a box from three points; rectangular doors only, because every block in the box is scanned (an arched door would take the wall above it along). Flood fill: grows out from seed blocks (irregular shapes). Region: a WorldEdit selection, captured with /gatedoor capture after saving; use it for arched and other non-rectangular doors, with //sel convex for a diagonal or vertical door and Door materials set below.",
          "fieldType": "Enum",
          "defaultValue": "PLANE_GRID",
          "isRequired": true,
          "isReadOnly": false,
          "settingsJson": "{\"enumValues\": [\"PLANE_GRID\", \"FLOOD_FILL\", \"REGION\"]}"
        },
        {
          "fieldGuid": "743178c9-fee2-5990-bc20-774ab677acda",
          "fieldName": "FaceDirection",
          "label": "Facing",
          "description": "The side the door's front faces. The info display and /gatedoor tp use it.",
          "fieldType": "Enum",
          "defaultValue": "NORTH",
          "isRequired": true,
          "isReadOnly": false,
          "settingsJson": "{\"enumValues\": [\"NORTH\", \"NORTH_EAST\", \"EAST\", \"SOUTH_EAST\", \"SOUTH\", \"SOUTH_WEST\", \"WEST\", \"NORTH_WEST\"]}"
        },
        {
          "fieldGuid": "d7426c91-6393-512c-b080-31373e077542",
          "fieldName": "IsActive",
          "label": "Active",
          "description": "Active doors are loaded and can be opened in game. Leave off until the door is scanned.",
          "fieldType": "Boolean",
          "defaultValue": "false",
          "isRequired": false,
          "isReadOnly": false
        }
      ]
    },
    {
      "stepGuid": "59700235-5327-5813-951e-1e661f81dea8",
      "stepName": "Shape: three points",
      "description": "Stand at each point in game and use Send to Minecraft, in this order: anchor, then point 1, then point 2. All three must be inside the gate's region. Only for the plane grid and region shapes.",
      "isManyToManyRelationship": false,
      "displayConditionGroups": [
        {
          "innerLogic": "And",
          "combineWithPreviousLogic": "And",
          "isActive": true,
          "conditions": [
            {
              "sourceFieldGuid": "89863b69-e84f-56a9-861b-7885a4673289",
              "operator": "In",
              "valueJson": "[\"PLANE_GRID\", \"REGION\"]"
            }
          ]
        }
      ],
      "fields": [
        {
          "fieldGuid": "73d8c510-8c42-5ed0-a201-29548bca479e",
          "fieldName": "AnchorPointId",
          "label": "Anchor (corner)",
          "description": "One bottom corner of the door in its closed position; the box and the scan start here.",
          "fieldType": "Object",
          "objectType": "Location",
          "isRequired": false,
          "isReadOnly": false,
          "settingsJson": "{\"worldTask\": {\"enabled\": true, \"taskType\": \"LocationSelection\"}}"
        },
        {
          "fieldGuid": "169df649-a8e6-5b52-bf72-e3eb3a042a67",
          "fieldName": "ReferencePoint1Id",
          "label": "Point 1 (width)",
          "description": "The block at the far end of the door's width, in line with the anchor. The width is worked out from it.",
          "fieldType": "Object",
          "objectType": "Location",
          "isRequired": false,
          "isReadOnly": false,
          "settingsJson": "{\"worldTask\": {\"enabled\": true, \"taskType\": \"LocationSelection\"}}"
        },
        {
          "fieldGuid": "da7a5d5d-5fc0-5a5b-9599-40e591c36a72",
          "fieldName": "ReferencePoint2Id",
          "label": "Point 2 (height)",
          "description": "The block at the far end of the door's height, at right angles to the anchor-point 1 line. The height is worked out from it.",
          "fieldType": "Object",
          "objectType": "Location",
          "isRequired": false,
          "isReadOnly": false,
          "settingsJson": "{\"worldTask\": {\"enabled\": true, \"taskType\": \"LocationSelection\"}}"
        },
        {
          "fieldGuid": "12f0a57a-1df5-5562-94fe-7c9fe337f901",
          "fieldName": "GeometryWidth",
          "label": "Width (blocks)",
          "description": "Blocks from the anchor to point 1, both included. Filled in from the two points once both are captured.",
          "fieldType": "Integer",
          "defaultValue": "0",
          "isRequired": false,
          "isReadOnly": false
        },
        {
          "fieldGuid": "c05fa338-7bc6-53d8-98ca-9b769c881d98",
          "fieldName": "GeometryHeight",
          "label": "Height (blocks)",
          "description": "Blocks from the anchor to point 2, both included. Filled in from the two points once both are captured.",
          "fieldType": "Integer",
          "defaultValue": "0",
          "isRequired": false,
          "isReadOnly": false
        },
        {
          "fieldGuid": "2efebaf4-40c5-597c-a024-0d3cd3714287",
          "fieldName": "GeometryDepth",
          "label": "Depth (blocks)",
          "description": "How many blocks thick the door is, at right angles to its face. 0 or 1 = a single layer.",
          "fieldType": "Integer",
          "defaultValue": "0",
          "isRequired": false,
          "isReadOnly": false
        }
      ]
    },
    {
      "stepGuid": "5fd8f34d-a8ef-5118-ab5e-747a14581eb7",
      "stepName": "Shape: flood fill",
      "description": "The scan starts at the seed blocks and adds every touching block, within the limits below. Only for the flood fill shape.",
      "isManyToManyRelationship": false,
      "displayConditionGroups": [
        {
          "innerLogic": "And",
          "combineWithPreviousLogic": "And",
          "isActive": true,
          "conditions": [
            {
              "sourceFieldGuid": "89863b69-e84f-56a9-861b-7885a4673289",
              "operator": "Equals",
              "valueJson": "\"FLOOD_FILL\""
            }
          ]
        }
      ],
      "fields": [
        {
          "fieldGuid": "89810d90-2347-52d6-83b5-311b919d0b0c",
          "fieldName": "SeedBlocks",
          "label": "Seed blocks",
          "description": "Coordinates of one or more door blocks as JSON, e.g. [{\"x\":10,\"y\":64,\"z\":-5}].",
          "fieldType": "String",
          "isRequired": true,
          "isReadOnly": false
        },
        {
          "fieldGuid": "a319d4d0-0983-5521-9913-121293ee3391",
          "fieldName": "ScanMaxBlocks",
          "label": "Maximum blocks",
          "description": "The scan stops after this many blocks, so a door touching a wall can't swallow the wall.",
          "fieldType": "Integer",
          "defaultValue": "500",
          "isRequired": false,
          "isReadOnly": false
        },
        {
          "fieldGuid": "bffd0f9d-a343-5960-b32e-daf89dea0516",
          "fieldName": "ScanMaxRadius",
          "label": "Maximum radius (blocks)",
          "description": "Blocks further than this from the first seed are never added.",
          "fieldType": "Integer",
          "defaultValue": "20",
          "isRequired": false,
          "isReadOnly": false
        },
        {
          "fieldGuid": "dfc88a16-d762-5b97-87fd-b0fa214a88f2",
          "fieldName": "ScanPlaneConstraint",
          "label": "Stay in one plane",
          "description": "Only add blocks in the seed's plane, so a flat door doesn't spread into the wall behind it.",
          "fieldType": "Boolean",
          "defaultValue": "false",
          "isRequired": false,
          "isReadOnly": false
        }
      ]
    },
    {
      "stepGuid": "f8fd7920-9fab-5f62-a3d5-69c10906f677",
      "stepName": "Motion",
      "description": "How the door moves between closed and open, and how long that takes.",
      "isManyToManyRelationship": false,
      "fields": [
        {
          "fieldGuid": "a7a9a6f0-05c4-5d62-8713-6cb541c36d68",
          "fieldName": "MotionType",
          "label": "Motion",
          "description": "Sliding and trap doors: Vertical (up/down) or Lateral (sideways). Drawbridges and double doors: Rotation.",
          "fieldType": "Enum",
          "defaultValue": "VERTICAL",
          "isRequired": true,
          "isReadOnly": false,
          "settingsJson": "{\"enumValues\": [\"VERTICAL\", \"LATERAL\", \"ROTATION\"]}"
        },
        {
          "fieldGuid": "059493d6-103c-540e-b14d-9b03a74d9d12",
          "fieldName": "MotionDistanceBlocks",
          "label": "Travel distance / deck length (blocks)",
          "description": "Sliding and trap doors: how far the door moves between closed and open; 0 = its height (vertical) or width (lateral). Drawbridges and other rotating doors: how many blocks the open deck reaches from the hinge, counted along the door's direction (so an 8-tall door makes an 8-block deck); 0 = the door's height. Only used when there is no open-door scan: a scanned open shape sets the length itself, and a different value here is reported in the server log.",
          "fieldType": "Integer",
          "defaultValue": "0",
          "isRequired": false,
          "isReadOnly": false,
          "displayConditionGroups": [
            {
              "innerLogic": "And",
              "combineWithPreviousLogic": "And",
              "isActive": true,
              "conditions": [
                {
                  "sourceFieldGuid": "a7a9a6f0-05c4-5d62-8713-6cb541c36d68",
                  "operator": "In",
                  "valueJson": "[\"VERTICAL\", \"LATERAL\", \"ROTATION\"]"
                }
              ]
            }
          ]
        },
        {
          "fieldGuid": "f4ff834c-4bce-5ecb-b61d-9d4e3cf628db",
          "fieldName": "ClipToGeometryBounds",
          "label": "Hide blocks outside the box",
          "description": "Blocks that move outside the width/height/depth box are hidden, so a door can slide into a housing and look smaller when open.",
          "fieldType": "Boolean",
          "defaultValue": "false",
          "isRequired": false,
          "isReadOnly": false
        },
        {
          "fieldGuid": "090808bb-d099-5159-be18-9ff2271cb187",
          "fieldName": "AnimationDurationTicks",
          "label": "Duration (ticks)",
          "description": "Time to open or close, in ticks (20 ticks = 1 second). Default 60 = 3 seconds.",
          "fieldType": "Integer",
          "defaultValue": "60",
          "isRequired": false,
          "isReadOnly": false
        },
        {
          "fieldGuid": "f5af9bfa-571d-5751-a737-12bf16d97679",
          "fieldName": "AnimationTickRate",
          "label": "Update every (frames)",
          "description": "Move the blocks every Nth frame. 1 = smoothest; higher values are cheaper but choppier.",
          "fieldType": "Integer",
          "defaultValue": "1",
          "isRequired": false,
          "isReadOnly": false
        }
      ]
    },
    {
      "stepGuid": "e59b181f-7708-53b7-9ee6-13367b2c89f9",
      "stepName": "Rotation",
      "description": "The hinge the door turns on. Only for rotating doors (drawbridges, double doors).",
      "isManyToManyRelationship": false,
      "displayConditionGroups": [
        {
          "innerLogic": "And",
          "combineWithPreviousLogic": "And",
          "isActive": true,
          "conditions": [
            {
              "sourceFieldGuid": "a7a9a6f0-05c4-5d62-8713-6cb541c36d68",
              "operator": "Equals",
              "valueJson": "\"ROTATION\""
            }
          ]
        }
      ],
      "fields": [
        {
          "fieldGuid": "1862ffaf-4f5b-52c9-8955-1b17ac35ae06",
          "fieldName": "HingeAxisId",
          "label": "Hinge",
          "description": "Stand on a block of the hinge line and use Send to Minecraft. It must be inside the gate's region.",
          "fieldType": "Object",
          "objectType": "Location",
          "isRequired": false,
          "isReadOnly": false,
          "settingsJson": "{\"worldTask\": {\"enabled\": true, \"taskType\": \"LocationSelection\"}}"
        },
        {
          "fieldGuid": "8e53daf6-2721-5e14-9326-799a2dd9c386",
          "fieldName": "RotationMaxAngleDegrees",
