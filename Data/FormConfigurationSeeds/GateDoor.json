    {
      "stepGuid": "1b6668ff-16b8-5216-8c9f-e8114378d4a5",
      "stepName": "Block scan",
      "description": "Records the door's blocks so the plugin can animate them. Save the door first (Submit), then Edit it and scan here; scan again whenever the door's blocks change in game. For a region or flood-fill door, set Door materials before the first scan.",
      "isManyToManyRelationship": false,
      "fields": [
        {
          "fieldGuid": "79cadff8-2538-563d-932c-6f7d01deb106",
          "fieldName": "TileEntityPolicy",
          "label": "Chests, signs and banners",
          "description": "Which block entities the scan keeps. None: skip them. Decorative only: signs, banners and the like. All: everything (container contents are not saved).",
