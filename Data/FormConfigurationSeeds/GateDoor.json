          "fieldType": "Integer",
          "defaultValue": "90",
          "isRequired": false,
          "isReadOnly": false
        },
        {
          "fieldGuid": "f1030241-2ad1-5847-a8b6-5203a1feb311",
          "fieldName": "LeftDoorSeedBlockId",
          "label": "Left wing block",
          "description": "Double doors only: a block of the left wing, so the scan can tell the wings apart.",
          "fieldType": "Object",
          "objectType": "Location",
          "isRequired": false,
          "isReadOnly": false,
          "settingsJson": "{\"worldTask\": {\"enabled\": true, \"taskType\": \"LocationSelection\"}}",
          "displayConditionGroups": [
            {
              "innerLogic": "And",
              "combineWithPreviousLogic": "And",
              "isActive": true,
              "conditions": [
                {
                  "sourceFieldGuid": "83bca48d-58cd-5333-823b-de4a36a1e884",
