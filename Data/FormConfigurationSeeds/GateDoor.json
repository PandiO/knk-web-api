        {
          "fieldGuid": "d7efcd9e-efd1-5c0d-a997-de808b183e36",
          "fieldName": "RightDoorSeedBlockId",
          "label": "Right wing block",
          "description": "Double doors only: a block of the right wing.",
          "fieldType": "Object",
          "objectType": "Location",
          "isRequired": false,
          "isReadOnly": false,
          "settingsJson": "{\"worldTask\": {\"enabled\": true, \"taskType\": \"LocationSelection\"}}",
          "displayConditionGroups": [
            {
              "innerLogic": "And",
              "combineWithPreviousLogic": "And",
              "isActive": true,
              "conditions": [
                {
                  "sourceFieldGuid": "83bca48d-58cd-5333-823b-de4a36a1e884",
                  "operator": "Equals",
                  "valueJson": "\"DOUBLE_DOORS\""
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "stepGuid": "37cee50a-8f54-599e-b1e5-d23f49f3e7dd",
      "stepName": "Block scan",
      "description": "Records the door's blocks so the plugin can animate them. Save the door first (Submit), then Edit it and scan here; scan again whenever the door's blocks change in game. For a region or flood-fill door, set Door materials before the first scan.",
      "isManyToManyRelationship": false,
      "fields": [
        {
          "fieldGuid": "05759a1e-aeb7-5659-bd0b-d050fa5fefec",
          "fieldName": "TileEntityPolicy",
          "label": "Chests, signs and banners",
          "description": "Which block entities the scan keeps. None: skip them. Decorative only: signs, banners and the like. All: everything (container contents are not saved).",
          "fieldType": "Enum",
          "defaultValue": "DECORATIVE_ONLY",
          "isRequired": true,
          "isReadOnly": false,
          "settingsJson": "{\"enumValues\": [\"NONE\", \"DECORATIVE_ONLY\", \"ALL\"]}"
        },
        {
          "fieldGuid": "9b019ebf-c6ad-5a1c-a0fe-4ddf17acff89",
          "fieldName": "ScanMaterialWhitelist",
          "label": "Door materials",
          "description": "Only blocks of these materials are kept by a region or flood-fill scan, e.g. spruce_planks, spruce_log, iron_bars (comma-separated, or a JSON list). Empty = every block in the selection. Set it for an arched or otherwise non-rectangular door captured as a region, so the wall inside the selection is not scanned as part of the door. Not used by the plane grid scan.",
          "fieldType": "String",
          "defaultValue": "",
          "isRequired": false,
          "isReadOnly": false,
          "displayConditionGroups": [
            {
              "innerLogic": "And",
              "combineWithPreviousLogic": "And",
              "isActive": true,
              "conditions": [
                {
                  "sourceFieldGuid": "89863b69-e84f-56a9-861b-7885a4673289",
                  "operator": "In",
                  "valueJson": "[\"FLOOD_FILL\", \"REGION\"]"
                }
              ]
            }
          ]
        },
        {
          "fieldGuid": "c58902a4-401e-5ee9-92d4-3a121754a964",
          "fieldName": "BlockSnapshots",
          "label": "Closed-door scan",
          "description": "Scan in Minecraft reads the closed door's blocks. Runs on the server; no player needed. Region doors: capture the closed region in game first (/gatedoor capture <door> closed).",
          "fieldType": "List",
          "elementType": "Object",
          "objectType": "GateBlockSnapshot",
          "isRequired": false,
          "isReadOnly": false,
          "canCreate": false,
          "settingsJson": "{\"worldTask\": {\"enabled\": true, \"taskType\": \"GateBlockScan\"}}"
        },
        {
          "fieldGuid": "69b4f6a4-6023-5b07-8c84-0f867dab69d3",
          "fieldName": "OpenAnchorPointId",
          "label": "Open-door anchor",
          "description": "Only for an open-door scan. Leave empty when the opened door stays inside the door box (it rises or slides and changes shape in place): the scan then starts at the anchor. Otherwise the block of the opened door's box that matches the anchor's corner - that box has the same width, height and depth, in the same directions, as the closed one. Not the upper corner of the closed box. Moving it makes an existing open-door scan useless: scan again.",
          "fieldType": "Object",
          "objectType": "Location",
          "isRequired": false,
          "isReadOnly": false,
          "settingsJson": "{\"worldTask\": {\"enabled\": true, \"taskType\": \"LocationSelection\"}}"
        },
        {
          "fieldGuid": "86ba1bf7-3518-5646-9ee4-03fa3e94edea",
          "fieldName": "OpenedBlockSnapshots",
          "label": "Open-door scan",
          "description": "Optional. Only for a door whose opened shape is more than its closed shape moved: build the opened door in the world, scan, then rebuild the closed door. A door that only rises or slides and loses decoration (chains) needs no scan: set the travel distance and keep \"Hide blocks outside the box\" on. Plane grid: scans the same box as the closed scan, from the open-door anchor (empty = the anchor). Region: first build the opened door, select it with WorldEdit and run /gatedoor capture <door> opened in game.",
          "fieldType": "List",
          "elementType": "Object",
          "objectType": "GateOpenedBlockSnapshot",
          "isRequired": false,
          "isReadOnly": false,
          "canCreate": false,
          "settingsJson": "{\"worldTask\": {\"enabled\": true, \"taskType\": \"GateOpenedBlockScan\"}}",
          "displayConditionGroups": [
            {
              "innerLogic": "And",
              "combineWithPreviousLogic": "And",
              "isActive": true,
              "conditions": [
                {
                  "sourceFieldGuid": "89863b69-e84f-56a9-861b-7885a4673289",
                  "operator": "In",
                  "valueJson": "[\"PLANE_GRID\", \"REGION\"]"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "stepGuid": "934a890c-c26b-59d2-a4b9-01fe9618b4e5",
      "stepName": "Health and respawn",
      "description": "How much damage the door takes before it breaks, and whether it comes back.",
      "isManyToManyRelationship": false,
      "fields": [
