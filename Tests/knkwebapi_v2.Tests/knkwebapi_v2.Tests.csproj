<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <!-- Closed alpha (2026-10-12): AutoMapper 12.0.1's DoS advisory is accepted, see KNG-165. The fix
       only exists in the licensed 15.1.1+/16.1.1+ lines; no request can build the ~25,000-level
       self-referencing graph it needs (System.Text.Json MaxDepth 64, no lazy loading). Only this
       advisory is suppressed - remove it when AutoMapper is upgraded or replaced. -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-rvv3-g6hj-g44x" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="8.0.10" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.1" />
    <PackageReference Include="AutoMapper" Version="12.0.1" />
    <PackageReference Include="AutoMapper.Extensions.Microsoft.DependencyInjection" Version="12.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="9.0.10" />
    <PackageReference Include="Moq" Version="4.20.70" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" Version="6.12.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\knkwebapi_v2.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Written against validator constructors that never shipped; awaiting a decision on what
         these tests should assert before they are rewritten. See ValidationMethodsTests.cs. -->
    <Compile Remove="Services\ValidationMethods\ValidationMethodsTests.cs" />
    <None Include="Services\ValidationMethods\ValidationMethodsTests.cs" />

    <!-- Built on a FormStep/FormField shape that no longer exists (Title, Order, string FieldType)
         and on older ValidationService/DependencyResolutionService constructors. Rewriting them to
         match today's code would only restate the implementation, so they need a decision first. -->
    <Compile Remove="Integration\DependencyResolutionE2ETests.cs" />
    <None Include="Integration\DependencyResolutionE2ETests.cs" />
    <Compile Remove="Integration\ValidationSystemIntegrationTests.cs" />
    <None Include="Integration\ValidationSystemIntegrationTests.cs" />

    <!-- Fixture builds ValidationService with an empty validator list, then individual tests try to
         register validators through a field that does not exist, and stub IValidationMethod with the
         wrong signature and result type. Never a working test; needs the same decision. -->
    <Compile Remove="Services\ValidationServiceTests.cs" />
    <None Include="Services\ValidationServiceTests.cs" />
  </ItemGroup>
</Project>
