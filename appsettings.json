{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "MySqlDbConnection": "Server=192.168.50.119;Database=knightsandkings_dev_v2;User=user;Password=password;Allow User Variables=True;"
  },
  "AllowedHosts": "*",
  "Urls": "http://0.0.0.0:5000",
  "Email": {
    "Provider": "Smtp",
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "UseStartTls": true,
    "SmtpUsername": "knightsandkingsmc@gmail.com",
    "SmtpPassword": "",
    "FromAddress": "knightsandkingsmc@gmail.com",
    "FromName": "Knights & Kings"
  },
  "Security": {
    "PluginApiKey": "",
    "AllowUnauthenticatedPluginCalls": false,
    "BcryptRounds": 10,
    "LinkCodeExpirationMinutes": 20,
    "SoftDeleteRetentionDays": 90,
    "PasswordResetTokenExpirationMinutes": 30,
    "PasswordResetRequestCooldownSeconds": 60,
    "PasswordResetFrontendBaseUrl": "http://localhost:3000",
    "PasswordResetExposeTokenInDevelopment": false,
    "Jwt": {
      "Issuer": "knk-api",
      "Audience": "knk-app",
      "Secret": "REPLACE_WITH_SECURE_SECRET_IN_PRODUCTION",
      "AccessTokenMinutes": 30,
      "RefreshTokenDays": 30
    }
  },
  "Discovery": {
    "MaxNewPerHour": 120
  },
  "Statistics": {
    "Enabled": true,
    "TimeZone": "Europe/Amsterdam",
    "MaxBatchEntries": 2000,
    "LateEventToleranceDays": 7,
    "FutureToleranceSeconds": 300,
    "ProjectionIntervalSeconds": 30,
    "ProjectionSafetyLagSeconds": 10,
    "SessionTimeoutMinutes": 5,
    "DailyRetentionDays": 730,
    "SessionRetentionDays": 365,
    "BatchRetentionDays": 30,
    "KillPairRetentionDays": 62
  },
  "Leaderboards": {
    "Enabled": true,
    "RefreshSeconds": 300,
    "MaxEntriesPerBoard": 5000,
    "RepeatVictimDailyCap": 3,
    "SnapshotRetentionDays": 400
  },
  "DiagnosticTelemetry": {
    "Enabled": true,
    "QueueCapacity": 10000,
    "MaxBatchSize": 500,
    "WriteIntervalSeconds": 2,
    "WriteBatchSize": 1000,
    "BaselineRetentionDays": 90,
    "EnhancedRetentionDays": 14,
    "LateEventToleranceDays": 7,
    "FutureToleranceSeconds": 300,
    "MaxEnhancedTargetHours": 168
  },
  "Privacy": {
    "DeletionDueDays": 30,
    "GraceDays": 5,
    "ConfirmationHours": 24,
    "ResendCooldownSeconds": 60,
    "AutoExecuteEnabled": true,
    "FrontendBaseUrl": ""
  },
  "WorldAnalytics": {
    "Enabled": true,
    "RetentionDays": 180,
    "BatchRetentionDays": 30,
    "MaxBatchRows": 20000,
    "LateBatchToleranceDays": 7,
    "MaxRangeDays": 92,
    "MaxHeatmapCells": 20000
  },
  "Telemetry": {
      "Enabled": true,
      "Exporter": "otlp",
      "Otlp": {
        "Endpoint": "http://localhost:4317",
        "EnableTracing": true,
        "EnableMetrics": true,
        "EnableLogging": true
      },
      "Prometheus": {
        "Endpoint": "/metrics",
        "Enabled": true
      }
    },
    "ClientActivity": {
      "Enabled": true,
      "MaxClients": 1000,
      "InactivityThreshold": "24:00:00",
      "CleanupInterval": "00:10:00",
      "RollingWindowMinutes": 60
    },
    "CurrencyMonitor": {
      "Enabled": true,
      "CycleSeconds": 60,
      "RuleIntervalMinutes": 5,
      "ReconciliationIntervalMinutes": 60,
      "AutoDisableTransfersOnMismatch": true,
      "InGameMinSeverity": "Low"
    }
}
