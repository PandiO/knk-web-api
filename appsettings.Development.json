{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Email": {
    "Provider": "Log"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "https://localhost:3000",
      "http://localhost:5294",
      "https://localhost:7104"
    ]
  },
  "Security": {
    "BcryptRounds": 10,
    "PasswordResetTokenExpirationMinutes": 30,
    "PasswordResetRequestCooldownSeconds": 30,
    "PasswordResetFrontendBaseUrl": "http://localhost:3000",
    "PasswordResetExposeTokenInDevelopment": true,
    "Jwt": {
      "Issuer": "knk-api-dev",
      "Audience": "knk-app-dev",
      "Secret": "",
      "AccessTokenMinutes": 30,
      "RefreshTokenDays": 30
    }
  },
  "Telemetry": {
    "Enabled": true,
    "Exporter": "otlp",
    "Otlp": {
      "Endpoint": "http://localhost:4317",
      "EnableTracing": true,
      "EnableMetrics": true,
      "EnableLogging": true
    },
    "Prometheus": {
      "Endpoint": "/metrics",
      "Enabled": true
    }
  },
  "ClientActivity": {
    "Enabled": true,
    "MaxClients": 1000,
    "InactivityThreshold": "24:00:00",
    "CleanupInterval": "00:10:00",
    "RollingWindowMinutes": 60
  }
}
